<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <servlet>
        <servlet-name>demo2</servlet-name>
        <servlet-class>demo2</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>uploadimg1</servlet-name>
        <servlet-class>uploadimg1</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>TableAdd</servlet-name>
        <servlet-class>TableAdd</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>tblupimg</servlet-name>
        <servlet-class>tblupimg</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>demo2</servlet-name>
        <url-pattern>/demo2</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>uploadimg1</servlet-name>
        <url-pattern>/uploadimg1</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>TableAdd</servlet-name>
        <url-pattern>/TableAdd</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>tblupimg</servlet-name>
        <url-pattern>/tblupimg</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
</web-app>
